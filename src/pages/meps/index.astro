---
import Base from '../../layouts/Base.astro';
import { MEMBER_STATES } from '../../core/eu';
import { GROUPS } from '../../core/groups';
import { slugify } from '../../core/slug';
import { atmosphereStats as s, linkByMep, meps } from '../../data';

const sorted = [...meps].sort((a, b) => a.familyName.localeCompare(b.familyName, 'en') || a.givenName.localeCompare(b.givenName, 'en'));
---
<Base title="Members of the European Parliament on Rostrum" description={`All ${s.total} Members of the European Parliament, with draft Rostrum profiles built from European Parliament open data. ${s.online} are already on the open social web.`}>
  <section class="dir" aria-labelledby="dir-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Directory</p>
        <h1 id="dir-title" class="page-title">All {s.total} Members of the European Parliament</h1>
        <p>Each Member has a draft Rostrum profile built from European Parliament open data, ready if they choose to claim it. <strong>{s.online}</strong> already post on the Atmosphere. No Member has created or endorsed these profiles.</p>
      </div>

      <form class="dir-filters" id="dir-filters" role="search" aria-label="Filter Members" hidden>
        <div class="field dir-q"><label for="dir-q">Search by name or party</label><input id="dir-q" type="search" autocomplete="off" placeholder="For example: Aaltola, Kokoomus"></div>
        <div class="field"><label for="dir-country">Member state</label><select id="dir-country"><option value="">All member states</option>{MEMBER_STATES.map((c) => <option>{c}</option>)}</select></div>
        <div class="field"><label for="dir-group">Political group</label><select id="dir-group"><option value="">All groups</option>{GROUPS.map((g) => <option value={g.short}>{g.short}: {g.label}</option>)}</select></div>
        <div class="check dir-atmo"><input type="checkbox" id="dir-atmo"><label for="dir-atmo">Only Members on the Atmosphere</label></div>
      </form>
      <p class="dir-count" id="dir-count" aria-live="polite">Showing {sorted.length} of {s.total} Members</p>

      <ul class="dir-list" id="dir-list">
        {sorted.map((m) => {
          const link = linkByMep.get(m.id);
          return (
            <li class="dir-item" data-name={slugify(`${m.givenName} ${m.familyName} ${m.nationalParty}`).replaceAll('-', ' ')} data-country={m.country} data-group={m.group} data-atmo={link ? '1' : '0'}>
              <img class="dir-photo" src={m.photo} alt="" width="56" height="70" loading="lazy" decoding="async" />
              <div class="dir-body">
                <a class="dir-name" href={`/meps/${m.slug}/`}>{m.givenName} {m.familyName}</a>
                <span class="dir-meta">{m.group} · {m.country}</span>
                {m.nationalParty && <span class="dir-party">{m.nationalParty}</span>}
                {link && <span class="dir-atmo-badge mono">@{link.handle}</span>}
              </div>
            </li>
          );
        })}
      </ul>
      <p class="dir-empty" id="dir-empty" hidden>No Members match these filters.</p>
      <p class="credit">Data: European Parliament open data. Photos © European Union – EP.</p>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/directory';
</script>
